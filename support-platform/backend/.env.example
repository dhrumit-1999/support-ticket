APP_NAME="Support Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

# Database Configuration (MySQL)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=support_platform
DB_USERNAME=root
DB_PASSWORD=

# Queue Configuration (Database driver - no Redis required)
QUEUE_CONNECTION=database
BATCHING_DATABASE=default

# Cache Configuration (Database driver - no Redis required)
CACHE_STORE=database
SESSION_DRIVER=database

# Mail Configuration
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@platform.com"
MAIL_FROM_NAME="${APP_NAME}"

# File Storage
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# JWT Configuration
JWT_SECRET=
JWT_TTL=15
JWT_REFRESH_TTL=10080

# Security
LOG_CHANNEL=stack
LOG_LEVEL=debug
